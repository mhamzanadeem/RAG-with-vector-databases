# ------------------------------------------------------------------
# Unified .gitignore
# ------------------------------------------------------------------

# ------------------- Python -------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------- RAG runtime data -------------------
# Uploaded documents, built vector indexes, and downloaded
# model weights are generated on the server, never committed.
backend/data/
backend/stores/
backend/model_cache/

# ------------------- Node / Next.js -------------------
node_modules/
.next/
out/
build/

# ------------------- Environment / secrets -------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------- Logs / temporary -------------------
*.log
npm-debug.log*
.yarn-error.log*
.DS_Store
Thumbs.db

# ------------------- IDEs / editors -------------------
.vscode/
.idea/
*.swp